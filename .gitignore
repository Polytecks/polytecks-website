# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual-regression harness output (commit compare.mjs only)
/compare/*.png
/compare/diff.json

# Session screenshot directories — useful locally for reference but
# not useful in the repo. The screenshots-redesign baseline that was
# already committed stays tracked via the negation below.
/compare/*/
!/compare/screenshots-redesign/

# Debug frame extracts saved at the repo root during media work
/frame_*.png
/frame_*.jpg

# Local snapshot of design-tweaks panel state (dev-only, used to lock in defaults)
/tweaks-snapshot.json

# Originals saved by scripts/image-audit.mjs before in-place compression.
# Kept locally for rollback; not useful in the repo.
/public/assets/_orig/
